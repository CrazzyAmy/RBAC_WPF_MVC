<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
	<connectionStrings>
		<add  name="WebDB" 
			  connectionString="Server=localhost;Initial Catalog=WebDB;Persist Security Info=False;User ID = import.meta.env.SQL_AC;Password = import.meta.env.SQL_PW;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Connection Timeout=30;" providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>