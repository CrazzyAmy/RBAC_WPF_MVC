<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <Style TargetType="Button" x:Key="FunBtn">
            <Setter Property="Width" Value="160"></Setter>
            <Setter Property="Height" Value="30"></Setter>
            <Setter Property="Margin" Value="5"></Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="200" Background="LightGray">
            <TextBlock x:Name="TextBlock1" Text="TextBlock1"/>
            <Button x:Name="AdminFun" Style="{StaticResource FunBtn}" Click="AdminFun_Click">管理員資料管理</Button>
            <Button x:Name="CustomerFun" Style="{StaticResource FunBtn}" Click="CustomerFun_Click">客⼾資料管理</Button>
            <TextBlock x:Name="MessageResult" />
        </StackPanel>
        <Frame Name="FunFrame" NavigationUIVisibility="Hidden"></Frame>
    </DockPanel>

</Window>
