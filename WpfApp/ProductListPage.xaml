<Page x:Class="WpfApp.ProductListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WpfApp"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="600"
      Title="ProductListPage">

    <Grid>
        <Border Background="#2F3C7E" Margin="20" Height="415"  CornerRadius="10" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="100"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Label  Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Normal" FontSize="15px">名稱:</Label>
                    <TextBlock Width="100" Height="30" Margin="5" Background="White" ></TextBlock>
                    <Label  Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Normal" FontSize="15px">類別:</Label>
                    <ComboBox Height="25" Width="50">
                        <ComboBoxItem>原料倉</ComboBoxItem>
                        <ComboBoxItem>成品倉</ComboBoxItem>
                    </ComboBox>
                    <Label  Margin="5" HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Normal" FontSize="15px">入庫時間:</Label>
                    <DatePicker Height="30" Width="100" FontSize="10" Margin="5"></DatePicker>
                    <Button Height="30" Width="80" Margin="5">查詢</Button>
                </StackPanel>
                <ListView x:Name="listview1" Grid.Row="1" Margin="10">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="倉別" Width="100" DisplayMemberBinding="{Binding Path=PortType}"/>
                            <GridViewColumn Header="名稱" Width="100" DisplayMemberBinding="{Binding Path=ProductName}" />
                            <GridViewColumn Header="數量" Width="100" DisplayMemberBinding="{Binding Path=ProductNumber}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
